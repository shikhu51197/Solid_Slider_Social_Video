# ==============================================================================
# Social Media Slider - Environment Configuration Template
# Do not commit real production secrets or access tokens to source control.
# ==============================================================================

# Meta Graph API (Instagram & Facebook)
# Required permissions/scopes: instagram_basic, pages_show_list, pages_read_engagement
VITE_META_APP_ID=your_meta_app_id_here
VITE_META_APP_SECRET=your_meta_app_secret_here
VITE_META_ACCESS_TOKEN=your_long_lived_meta_page_access_token_here
VITE_INSTAGRAM_USER_ID=your_instagram_business_account_id_here
VITE_FACEBOOK_PAGE_ID=your_facebook_page_id_here

# YouTube Data API v3
# Required scopes: https://www.googleapis.com/auth/youtube.readonly
# Standard quota: 10,000 units/day
VITE_YOUTUBE_API_KEY=your_google_cloud_youtube_api_key_here
VITE_YOUTUBE_CHANNEL_ID_MAIN=UC_your_bajaj_finance_channel_id
VITE_YOUTUBE_CHANNEL_ID_MONEY_ADDA=UC_your_money_adda_channel_id

# Cache & Polling Configuration
# Default: 300000 ms (5 minutes) to protect against platform rate limiting
VITE_SOCIAL_CACHE_TTL_MS=300000
