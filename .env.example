# ==============================================================================
# Live Commerce Social Media Slider POC - Environment Variables Template
# Private access tokens and secrets must remain server-side and never prefixed with NEXT_PUBLIC_ or VITE_
# ==============================================================================

# 1. Instagram Creator API (Server-Side Only - Private)
# Generated via Meta Developer App / Instagram Graph API Explorer
# Endpoint used: https://graph.instagram.com/v26.0/me/media
# Supported scopes: instagram_basic, instagram_manage_comments, instagram_manage_insights
INSTAGRAM_ACCESS_TOKEN=your_instagram_user_access_token_here
INSTAGRAM_USER_ID=your_instagram_user_id_here

# 2. Facebook Graph API (Server-Side Only - Private)
# Generated via Meta App Dashboard for your authorized Facebook Page
# Endpoint used: https://graph.facebook.com/v26.0/{page-id}/posts
# Supported scopes: pages_show_list, pages_read_engagement, pages_read_user_content
FACEBOOK_PAGE_ID=your_facebook_page_id_here
FACEBOOK_PAGE_ACCESS_TOKEN=your_facebook_page_access_token_here

# 3. YouTube Data API v3 (Server-side only)
# Generated via Google Cloud Console
# Standard quota: 10,000 units/day
YOUTUBE_API_KEY=your_google_cloud_youtube_api_key_here
YOUTUBE_CHANNEL_HANDLE=@bajaj_finance_limited
